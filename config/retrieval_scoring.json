    "minimum_relative_chunk_score": 0.85,
    "bonus_per_support_chunk": 0.025,
    "maximum_support_bonus": 0.075,
    "section_diversity_bonus_per_additional_section": 0.01,
    "maximum_section_diversity_bonus": 0.02,
    "paper_score_formula": "best_chunk_score + support_bonus + section_diversity_bonus"
  },
  "cross_encoder": {
    "maximum_papers_reranked": 20,
    "calibration": "sigmoid(clip(raw_score / 3, -12, 12))",
    "paper_score_addition_weight": 0.16,
    "minimum_calibrated_score": 0.50,
    "input_abstract_word_limit": 120,
    "input_excerpt_word_limit": 180,
    "note": "Papers without a cross-encoder score are removed by the minimum-score filter; therefore no more than the first 20 paper candidates can proceed."
  },
  "mmr": {
    "lambda": 0.78,
    "minimum_candidate_pool": 15,
    "candidate_pool_formula": "min(max(top_k * 3, 15), number_of_available_papers)",
    "score_formula": "(0.78 * normalized_paper_relevance) - (0.22 * maximum_cosine_similarity_to_selected_papers)",
    "representative_text_embedding_normalization": true,
    "input_abstract_word_limit": 120,
    "input_excerpt_word_limit": 180
  },
  "final_scoring": {
    "cross_encoder_weight": 0.70,
    "embedding_weight": 0.30,
    "formula": "(0.70 * calibrated_cross_encoder_score) + (0.30 * embedding_score)",
    "note": "The final displayed ranking score does not directly include the BM25, field, section, source, support, or MMR scores. These affect candidate selection and intermediate ranking."
  }
