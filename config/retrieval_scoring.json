    "candidate_scores": "Min-max normalization performed separately for embedding scores and BM25 scores within the merged candidate set.",
    "equal_value_rule": "If all values are equal, all scores become 1.0 when the common value is positive; otherwise they become 0.0.",
    "semantic_distance": "sqrt(max(0, 2 - 2 * cosine_similarity))",
